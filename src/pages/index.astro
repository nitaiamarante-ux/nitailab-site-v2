---
import Base from '../layouts/Base.astro';
---

<Base title="Nitai Lab" description="Nitai Lab, Pará de Minas (MG). Página em atualização.">
  <main class="atualizacao">
    <div class="container container--sm atualizacao__inner">
      <svg class="atualizacao__logo" viewBox="0 0 40 20" width="40" height="20" fill="none" aria-hidden="true">
        <path d="M0 12 L8 12 L12 4 L16 16 L20 8 L24 12 L40 12" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <h1>Estamos reformando esta página.</h1>
      <p class="atualizacao__texto">Enquanto isso, o Resgate seu Google segue funcionando normal.</p>
      <a href="https://resgateseugoogle.nitailab.com.br/" class="btn btn--primary">Conhecer o Resgate seu Google</a>
      <p class="atualizacao__zap">Prefere conversar? Chama no WhatsApp: <a href="https://wa.me/5531982976006">(31) 98297-6006</a></p>
    </div>
  </main>

  <footer class="atualizacao__rodape">
    <div class="container">
      Nitai Lab · Pará de Minas, MG · <a href="mailto:comercial@nitailab.com.br">comercial@nitailab.com.br</a> · <a href="/politica-de-privacidade/">Política de privacidade</a>
    </div>
  </footer>
</Base>

<style>
  .atualizacao {
    min-height: calc(100vh - 90px);
    display: flex;
    align-items: center;
    padding: var(--space-lg) 0;
  }
  .atualizacao__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }
  .atualizacao__logo {
    width: 40px;
    height: 20px;
    color: var(--gold);
  }
  .atualizacao__texto {
    font-size: 1.125rem;
    color: var(--mid);
    margin-bottom: var(--space-xs);
  }
  .atualizacao__zap {
    margin-top: var(--space-sm);
    font-size: 0.9375rem;
    color: var(--mid);
  }
  .atualizacao__rodape {
    border-top: 1px solid var(--bdr);
    padding: 1.5rem 0;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--soft);
  }
  .atualizacao__rodape a {
    color: var(--mid);
  }
</style>
